{
  "appId": "dev.outliner.app",
  "appName": "Outliner",
  "webDir": "../web/dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
