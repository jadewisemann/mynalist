{
  "name": "outliner-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri 2 shell wrapping the existing Outliner web build (macOS + Android)",
  "scripts": {
    "tauri": "tauri",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "cargo:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "cargo:build:release": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "android:init": "tauri android init",
    "android:build": "tauri android build",
    "android:build:debug": "tauri android build --debug --apk"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "tauri": "npm:@tauri-apps/cli@^2.12.4"
  }
}
