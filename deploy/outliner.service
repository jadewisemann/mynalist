# systemd --user unit: serves the API + web build on localhost:8080;
# expose it with `sudo tailscale funnel --bg 8080` (public HTTPS, WebSocket ok).
# Install: deploy/install.sh   (creates ~/.config/outliner/env with secrets)
[Unit]
Description=Outliner sync server
After=network-online.target

[Service]
WorkingDirectory=%h/code/outliner
EnvironmentFile=%h/.config/outliner/env
ExecStart=/usr/bin/env node apps/server/src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
